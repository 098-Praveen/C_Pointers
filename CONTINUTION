POST INCREMENT AND PRE INCREMENT:

int a[] = {10, 20, 30};
int *p = &a[0];

printf("%d\n", *p++); = 10
printf("%d\n", *p); = 20
*p++ means *(p++)
here first take the first value then increment the address

int a[] = {10, 20, 30};
int *p = &a[0];

printf("%d\n", *++p); = 20
printf("%d\n", *p); = 20

here *(++p) means first increment the address then print the value
so 

| Expression |    |     Meaning     |

| `*p++`   | Access first, increment afterward |
| `*++p`   | Increment first, access afterward |
| `(*p)++` | Increment the value pointed to by p |
| `++(*p)` | Increment the pointed-to value first |

(*p)++  post increment value
++(*p)  pre increment value

int a[] = {10, 20, 30, 40, 50};
p=&a[2]
*(p-1)
here p-1 moves back to the element don't change the address in p
#include <stdio.h>

int main()
{
    int a[] = {10, 20, 30, 40, 50};
    int *p = &a[1];

    printf("%d\n", *(p + 2)); //40

    p++;

    printf("%d\n", *p); //30
    printf("%d\n", *(p - 1)); //20

    p = p + 2;

    printf("%d\n", *p); //50
    printf("%d\n", *(p - 2)); //30
    printf("%d\n",*p);//50

    return 0;
}

